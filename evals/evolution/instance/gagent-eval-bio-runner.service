# systemd user unit for the evaluation instance's bio_tools runner (account `platform`).
# Same runner code as the live service (/data3/platform/gagent/bio-runner), but it only
# watches the evaluation runtime. The unit file lives in /data3/platform/gagent/systemd/;
# ~/.config/systemd/user/ only holds a link to it:
#   systemctl --user link /data3/platform/gagent/systemd/gagent-eval-bio-runner.service
#   systemctl --user enable --now gagent-eval-bio-runner
[Unit]
Description=GAgent evaluation instance: native bio_tools runner
After=network.target

[Service]
Type=simple
WorkingDirectory=/data3/platform/gagent/bio-runner
ExecStart=/data3/platform/gagent/conda/envs/gagent-host/bin/python /data3/platform/gagent/bio-runner/native_runner.py \
  --runtime-dir /data3/platform/gagent/eval/runtime/bio_tools \
  --read-root /data3/platform/gagent/eval/runtime \
  --read-root /data3/platform/gagent/refdata \
  --db-root /data3/platform/gagent/databases \
  --conda-base /data3/platform/gagent/conda/miniforge3 \
  --conda-envs-dir /data3/platform/gagent/conda/envs \
  --keep-days 7 \
  --partition work
Restart=always
RestartSec=5
StandardOutput=append:/data3/platform/gagent/logs/bio-runner-eval.log
StandardError=append:/data3/platform/gagent/logs/bio-runner-eval.log

[Install]
WantedBy=default.target

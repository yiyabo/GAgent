# Platform SSO / BioAgent API integration
#
# These variables configure server-to-server access to the main platform.
# All platform-origin requests (SSO login, project context, future file/
# session/plan/artifact APIs) are routed through PlatformApiClient using
# these values. None of them are hardcoded in source.
#
# Leave them unset to keep platform access disabled (local-mode only);
# the platform code path will fail closed rather than fall back to local.

# Base URL of the main platform's BioAgent API (no trailing slash).
# Example: http://119.147.24.196:3087/api/v1/bioagent
PLATFORM_API_BASE_URL=

# Service-to-service API key sent as X-Api-Key to the main platform.
PLATFORM_API_KEY=

# Full URL of the SSO token verification endpoint.
# Example: http://119.147.24.196:3087/api/v1/sso/verify-token/
PLATFORM_SSO_VERIFY_URL=

# Per-request timeout (seconds) for main-platform HTTP calls.
PLATFORM_API_TIMEOUT_SECONDS=10.0

# Lifetime (seconds) of the single-use browser SSO handoff token.
# Range: 30-900. The handoff is consumed once by /auth/sso-complete.
SSO_HANDOFF_TTL_SECONDS=120

# Comma-separated allowlist of frontend origins that /sso/login/ may
# redirect to. Prevents open redirect via the __sso_handoff parameter.
# Example: http://bioagent.byoryn.cn,https://bioagent.byoryn.cn
SSO_ALLOWED_REDIRECT_ORIGINS=

# Shared secret required to call /sso/users/ (platform -> agent user sync).
# When set, the platform must send X-Sso-Sync-Key with this value.
SSO_USER_SYNC_API_KEY=
DATA_PROFILER_ALLOWED_ROOTS=

# Auth endpoint rate limits (requests per fixed window per identity).
# Defaults shown; windows: register/login/change-password = 15 min, SSO = 60 s.
# Raise (e.g. 100000) only on isolated stress-test deployments.
RATE_LIMIT_REGISTER=5
RATE_LIMIT_LOGIN=10
RATE_LIMIT_CHANGE_PASSWORD=5
RATE_LIMIT_SSO_COMPLETE=10
RATE_LIMIT_SSO_LOGIN=10

# Persistent file logging (survives restarts). Writes JSON lines to
# LOG_DIR/app.log with size rotation (50MB x 10 files). Stdout stays on.
LOG_FILE_ENABLED=1
LOG_DIR=logs

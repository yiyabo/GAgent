# Build context for the gateway image (deploy/Dockerfile.gateway).
# It needs the frontend sources and the nginx configs, nothing else.
*
!web-ui/
!web-ui/package.json
!web-ui/package-lock.json
!web-ui/tsconfig.json
!web-ui/tsconfig.node.json
!web-ui/vite.config.ts
!web-ui/index.html
!web-ui/postcss.config.js
!web-ui/tailwind.config.js
!web-ui/src/
!web-ui/public/
!web-ui/patches/
!deploy/
!deploy/nginx/

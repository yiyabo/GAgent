# GAgent gateway image: nginx serving the built web-ui — the stack's single
# entrypoint (see deploy/nginx/gagent.conf).
#
# WHY THERE IS NO node STAGE
# Hosts in this deployment cannot pull Docker Hub images. Measured 2026-10-10:
# registry-1.docker.io times out from .8, the daemon's dockerproxy.net mirror is
# dead, the docker.1ms.run mirror answers on /v2/ but times out for real pulls,
# and the byoryn registry carries python/alpine but no node. So the SPA is built
# where node exists (the Mac, which is also how this project has always shipped
# its frontend) and the resulting web-ui/dist is baked in from the build context.
# `gagentctl build` runs that frontend build first and fails loudly if dist is
# missing or if a backend origin leaked into the bundle.
#
# The nginx base is the byoryn-maintained nginx image already present on .8
# (nginx 1.29.6). Override GATEWAY_BASE_IMAGE for a different provenance.
ARG GATEWAY_BASE_IMAGE=docker.byoryn.cn/ms/webui:ms
FROM ${GATEWAY_BASE_IMAGE}

# Replace the base image's own site config and static assets with ours.
#
# Removing default.conf is NOT enough: the base image's entrypoint runs
# /docker-entrypoint.d/20-envsubst-on-templates.sh, which regenerates
# /etc/nginx/conf.d/default.conf from /etc/nginx/templates/*.template on EVERY
# container start. That template points at the base image's own backend
# (web-api-asgi), so nginx died at startup with
# `host not found in upstream "web-api-asgi"` and crash-looped. Removing the
# templates leaves our config as the only one.
RUN rm -f /etc/nginx/conf.d/default.conf /etc/nginx/templates/*.template
COPY deploy/nginx/gagent.conf /etc/nginx/conf.d/gagent.conf
COPY deploy/nginx/gagent_proxy_common.conf /etc/nginx/gagent_proxy_common.conf
RUN rm -rf /usr/share/nginx/html && mkdir -p /usr/share/nginx/html
COPY web-ui/dist /usr/share/nginx/html

# Build gate: no RUNTIME .js may carry a baked-in backend origin, or every
# browser request would go to the wrong host (LOCAL_INFRA §3 blood lesson).
# Scoped to .js on purpose: source maps (*.js.map) legitimately mention the dev
# origin and are not executed. (Shipping .map files at all is a separate,
# minor, information-disclosure question — see §121.)
RUN set -e; \
    hits=$(grep -rl --include='*.js' ":9000" /usr/share/nginx/html 2>/dev/null | wc -l); \
    echo "runtime .js files containing ':9000': ${hits}"; \
    test "${hits}" -eq 0

# The config must parse (fails the build, not the deploy).
RUN nginx -t

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

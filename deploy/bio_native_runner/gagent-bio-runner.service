[Unit]
Description=GAgent native bio_tools runner (Slurm + environment modules)
After=network.target

[Service]
Type=simple
WorkingDirectory=/data1/gagent/bio-runner
ExecStart=/usr/bin/python3 /data1/gagent/bio-runner/native_runner.py \
  --runtime-dir /home/wangyichun/gagent/runtime/bio_tools \
  --read-root /home/wangyichun/gagent/runtime \
  --read-root /home/wangyichun/gagent/refdata \
  --db-root /data1/gagent/databases \
  --conda-base /home/wangyichun/miniconda3 \
  --conda-envs-dir /data1/gagent/conda/envs \
  --partition work
Restart=always
RestartSec=5
StandardOutput=append:/data1/gagent/logs/bio-runner.log
StandardError=append:/data1/gagent/logs/bio-runner.log

[Install]
WantedBy=default.target

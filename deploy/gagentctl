#!/usr/bin/env bash
# gagentctl — one entrypoint for the GAgent compose stack (LOCAL_INFRA §120+).
#
# Replaces the ad-hoc start_all.sh / phage-safe-restart pair for the container
# stack. Every mutating command goes through the restart gate first, so a
# deploy can never kill an in-flight chat run or plan job.
#
# Usage: ./deploy/gagentctl <command> [args]
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEPLOY_DIR="${ROOT_DIR}/deploy"
COMPOSE=(docker compose -f "${DEPLOY_DIR}/docker-compose.yml")
[ -f "${DEPLOY_DIR}/.env" ] || { echo "missing ${DEPLOY_DIR}/.env (copy .env.template)"; exit 1; }
# shellcheck disable=SC1091
set -a; source "${DEPLOY_DIR}/.env"; set +a
# .env is the *container* contract, not a host-shell contract: its
# DOCKER_HOST=tcp://proxy:2375 points at a compose-internal name the host
# cannot resolve, so every docker CLI call below would fail and the gate
# silently reported "app not running" on a healthy stack (same class as the
# p2-cutover leak c150b8ea; measured 2026-10-11).
unset DOCKER_HOST
APP_CONTAINER="gagent-app-1"
GATE_LOG="${GAGENT_RUNTIME_DIR:-/tmp}/../restarts.log"

log() { printf '[gagentctl] %s\n' "$*"; }
die() { printf '[gagentctl] ERROR: %s\n' "$*" >&2; exit 1; }

# Active chat runs (same criteria as reap_expired_chat_runs) + queued/running
# decomposition jobs across every plan shard. Non-zero => refuse to restart.
gate() {
  local mode="${1:-enforce}"
  local services
  services=$("${COMPOSE[@]}" ps --status running --services) || die "cannot inspect the running stack; restart state is unknown"
  # On a FRESH stack there is no app container, so the probe below would fail and
  # abort `up` before anything starts. Nothing can be interrupted if nothing is
  # running, so treat "app not running" as an automatically clear gate.
  if ! grep -qx app <<< "${services}"; then
    log "gate: app service is not running — nothing to interrupt, gate clear"
    return 0
  fi
  local rc=0
  "${COMPOSE[@]}" exec -T app python - < "${ROOT_DIR}/app/ops/restart_gate.py" || rc=$?
  if [ "${rc}" -ne 0 ]; then
    if [ "${mode}" = "force" ] || [ "${mode}" = "--force" ]; then
      log "WARNING: gate is not clear (rc=${rc}) but --force given; proceeding"
      # Audit trail for forced restarts (GATE_LOG existed since P1 but was
      # never written; wired here in P4). Host-side file next to the runtime
      # tree — the container-side equivalent used to be /app/data/logs.
      printf '%s force-restart gate_rc=%s\n' "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "${rc}" >> "${GATE_LOG}"
    else
      die "restart gate not clear (active work or unknown state); use --force to override"
    fi
  fi
}

smoke() {
  log "smoke: import + readiness + tracebacks"
  "${COMPOSE[@]}" exec -T app python -c "import app.main; print('IMPORT_OK')"
  # tiktoken must load from the baked cache, not the network: a cold load
  # froze the event loop for ~390 s on 2026-10-12 (LOCAL_INFRA §129).
  local tk
  tk=$("${COMPOSE[@]}" exec -T app python -c "import time,tiktoken;t=time.time();tiktoken.get_encoding('cl100k_base');dt=time.time()-t;print(round(dt,3));assert dt<5,'tiktoken load %.1fs (baked cache missing?)'%dt") \
    || die "tiktoken load check failed (baked cache missing?)"
  log "smoke: tiktoken load ${tk}s"
  local code
  code=$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:${GATEWAY_PORT:-40003}/health/ready")
  [ "${code}" = "200" ] || die "gateway /health/ready returned ${code}"
  local tb
  tb=$("${COMPOSE[@]}" logs --since 4m app 2>&1 | grep -ci traceback || true)
  [ "${tb}" = "0" ] || die "found ${tb} traceback(s) in app logs"
  log "smoke OK (ready=200, tracebacks=0)"
}

# Build with plain `docker build`, NOT `docker compose build`.
# Reason (measured 2026-10-10 on .8): the host runs docker 20.10.24 (API 1.41)
# while its buildx *plugin* speaks API 1.52, so the compose build path dies with
# "client version 1.52 is too new. Maximum supported API version is 1.41" and the
# default builder shows STATUS=error. `DOCKER_BUILDKIT=1 docker build` uses the
# daemon's own BuildKit and works, and it still honours the per-Dockerfile
# dockerignore, so the build args have to be passed explicitly here.
# Checksum list of every file under a frontend tree, as `md5  ./path` lines in
# byte order. Run on the host (web-ui/dist) and inside the gateway image
# (/usr/share/nginx/html) so the two can be compared line for line.
frontend_manifest_cmd='find . -type f | LC_ALL=C sort | xargs md5sum'

# The gateway image must serve exactly the web-ui/dist this build produced,
# stamped with the commit being built. An image whose html differs from dist
# (a reused layer, a stale context) or whose build-info.json names another
# commit fails the build here instead of reaching a release.
verify_gateway() {
  local tag="$1" sha="$2"
  local dist="${ROOT_DIR}/web-ui/dist"
  [ -f "${dist}/build-info.json" ] || die "verify: ${dist}/build-info.json missing (run gagentctl build)"
  local want got
  want=$(cd "${dist}" && sh -c "${frontend_manifest_cmd}") || die "verify: cannot checksum ${dist}"
  got=$(docker run --rm --entrypoint sh -w /usr/share/nginx/html "gagent-gateway:${tag}" -c "${frontend_manifest_cmd}") \
    || die "verify: cannot read the frontend inside gagent-gateway:${tag}"
  if [ "${want}" != "${got}" ]; then
    diff <(printf '%s\n' "${want}") <(printf '%s\n' "${got}") | head -20 >&2 || true
    die "verify: gagent-gateway:${tag} does not serve this build's web-ui/dist"
  fi
  local built_commit
  built_commit=$(docker run --rm --entrypoint cat "gagent-gateway:${tag}" /usr/share/nginx/html/build-info.json \
    | sed -n 's/.*"commit": *"\([0-9a-f]*\)".*/\1/p')
  [ "${built_commit}" = "${sha}" ] \
    || die "verify: gagent-gateway:${tag} frontend is from commit '${built_commit}', expected ${sha}"
  log "verify OK: gagent-gateway:${tag} serves web-ui/dist of ${sha} ($(printf '%s\n' "${want}" | wc -l | tr -d ' ') files)"
}

build() {
  local tag="${GAGENT_TAG:-latest}"
  local sha dirty=false
  sha=$(git -C "${ROOT_DIR}" rev-parse HEAD 2>/dev/null) || die "build must run from a git checkout (cannot resolve HEAD)"
  [ -z "$(git -C "${ROOT_DIR}" status --porcelain --untracked-files=no)" ] || dirty=true
  log "source ${sha} (dirty=${dirty})"
  log "building gagent-app:${tag}"
  DOCKER_BUILDKIT=1 docker build \
    -f "${DEPLOY_DIR}/Dockerfile" \
    -t "gagent-app:${tag}" \
    --label "org.opencontainers.image.revision=${sha}" \
    --build-arg "BASE_IMAGE=${APP_BASE_IMAGE:-python:3.12-slim}" \
    --build-arg "APP_UID=${APP_UID:-1001}" \
    --build-arg "APP_GID=${APP_GID:-1001}" \
    "${ROOT_DIR}" || die "app image build failed"

  # The SPA is built here, not inside the image: this host cannot pull node
  # (no Docker Hub route — see deploy/Dockerfile.gateway). The build needs node
  # on the machine running gagentctl.
  log "building frontend (needs node on this host)"
  # VITE_DEFAULT_LANGUAGE (en | zh-CN) is the UI language before a visitor picks one; unset means en.
  ( cd "${ROOT_DIR}/web-ui" \
      && VITE_API_BASE_URL='' VITE_WS_BASE_URL='' VITE_DEFAULT_LANGUAGE="${VITE_DEFAULT_LANGUAGE:-}" npm run build ) || die "frontend build failed"
  local hits
  # Runtime .js only: source maps legitimately contain the dev origin and are
  # never executed (same rule as the gate inside deploy/Dockerfile.gateway).
  hits=$({ grep -rl --include='*.js' ":9000" "${ROOT_DIR}/web-ui/dist" 2>/dev/null || true; } | wc -l | tr -d ' ')
  [ "${hits}" -eq 0 ] || die "frontend runtime .js contains ':9000' (${hits} file(s))"
  # Stamp the bundle with its commit. vite output alone is not tied to a commit:
  # unchanged web-ui sources can rebuild byte-identical to an older release
  # (BuildKit then rightly reuses that release's layer and image), or differ
  # only in chunk hashes between two builds of the same source.
  printf '{"commit": "%s", "dirty": %s}\n' "${sha}" "${dirty}" > "${ROOT_DIR}/web-ui/dist/build-info.json"

  log "building gagent-gateway:${tag}"
  DOCKER_BUILDKIT=1 docker build \
    -f "${DEPLOY_DIR}/Dockerfile.gateway" \
    -t "gagent-gateway:${tag}" \
    --label "org.opencontainers.image.revision=${sha}" \
    --build-arg "GATEWAY_BASE_IMAGE=${GATEWAY_BASE_IMAGE:-docker.byoryn.cn/ms/webui:ms}" \
    "${ROOT_DIR}" || die "gateway image build failed"
  verify_gateway "${tag}" "${sha}"
  log "images built"
}

reprobe() {
  local base="${1:-https://phageagent.deepomics.org}"
  log "security re-probe against ${base} (expect 401 for protected paths)"
  local rc=0
  for p in /tools/available /usage/overview /tasks/1/result /skill-learning/skills/x /plans/1/results; do
    local code; code=$(curl -s -o /dev/null -w '%{http_code}' -m 12 "${base}${p}")
    printf '  %-28s -> %s\n' "${p}" "${code}"
    [ "${code}" = "401" ] || rc=1
  done
  local h; h=$(curl -s -o /dev/null -w '%{http_code}' -m 12 "${base}/health")
  printf '  %-28s -> %s\n' /health "${h}"; [ "${h}" = "200" ] || rc=1
  [ "${rc}" -eq 0 ] || die "re-probe failed: a protected path is not 401"
  log "re-probe OK"
}

cmd="${1:-}"; shift || true
case "${cmd}" in
  build)   build ;;
  verify-gateway)
    verify_gateway "${1:-${GAGENT_TAG:-latest}}" "$(git -C "${ROOT_DIR}" rev-parse HEAD)" ;;
  # --no-build everywhere: images are built by `build` (plain docker build);
  # letting compose build here would hit the buildx/daemon mismatch above.
  up)      gate enforce; "${COMPOSE[@]}" up -d --no-build "$@"; smoke ;;
  down)
    mode=enforce
    if [ "${1:-}" = "force" ] || [ "${1:-}" = "--force" ]; then mode=force; shift; fi
    gate "${mode}"; "${COMPOSE[@]}" down "$@" ;;
  gate)    gate "${1:-enforce}" ;;
  smoke)   smoke ;;
  reprobe) reprobe "$@" ;;
  deploy)  gate "${1:-enforce}"; "${COMPOSE[@]}" up -d --no-build; smoke ;;
  # Ops verbs (P4): one-off containers from the ops service definition, so
  # they see the same volumes/env without touching the running cron loop.
  # `backup` is non-mutating (no gate); `restore` stops the app, so it goes
  # through the gate first (pass "force" to override, like deploy).
  backup)  "${COMPOSE[@]}" run --rm -T --no-deps ops python -m app.ops.backup "$@" ;;
  restore)
    ts="${1:-}"
    [ -n "${ts}" ] || die "usage: gagentctl restore <ts>  (list: gagentctl backup --list)"
    gate "${2:-enforce}"
    log "restore ${ts}: stopping app, restoring, starting app"
    "${COMPOSE[@]}" stop app
    if ! "${COMPOSE[@]}" run --rm -T --no-deps ops python -m app.ops.backup --restore "${ts}"; then
      "${COMPOSE[@]}" start app
      die "restore failed; app restarted on the pre-restore data"
    fi
    "${COMPOSE[@]}" start app
    # Give the app a moment to run its startup migrations before probing.
    sleep 8
    smoke ;;
  logs)    "${COMPOSE[@]}" logs -f --tail=200 app ;;
  ps)      "${COMPOSE[@]}" ps ;;
  # Image transport for hosts that cannot pull (the .8 reality): save on a
  # networked machine, load here.
  # Export only what is actually built: the sandbox images arrive in P3, and
  # `docker save` fails the whole command if any named image is absent.
  export-images)
    tag="${GAGENT_TAG:-latest}" out="${1:-/tmp/gagent-images.tgz}" imgs=()
    for img in gagent-app gagent-gateway gagent-sandbox-python gagent-sandbox-qwen; do
      if docker image inspect "${img}:${tag}" >/dev/null 2>&1; then
        imgs+=("${img}:${tag}")
      else
        log "export: skipping ${img}:${tag} (not built on this host)"
      fi
    done
    [ "${#imgs[@]}" -gt 0 ] || die "nothing to export (no stack images built)"
    docker save "${imgs[@]}" | gzip > "${out}"
    log "wrote ${out} (${#imgs[@]} image(s))" ;;
  import-images) gunzip -c "${1:-/tmp/gagent-images.tgz}" | docker load ;;
  *) cat <<EOF
gagentctl commands:
  build            build app + gateway images, then verify-gateway
  verify-gateway [tag]  check the gateway image serves this checkout's web-ui/dist and commit
  up               gate, start the stack, smoke
  down             stop the stack
  deploy           gate, (re)start, smoke
  gate [force]     print active work; non-zero if a restart would interrupt it
  smoke            import + /health/ready + traceback check
  reprobe [base]   assert protected paths 401 from outside
  export-images    docker save the stack images to a tarball
  import-images    docker load the tarball
  backup [--list]  SQLite online backup (VACUUM INTO) into the backup dir
  restore <ts> [force]  gate, stop app, restore backup <ts>, start, smoke
  logs | ps
EOF
     exit 2 ;;
esac

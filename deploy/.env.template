# GAgent deployment environment. Copy to .env and fill in; .env is gitignored.
# Every value the stack needs lives here — the compose file sets no defaults
# except for the container-internal overrides it computes.
#
# SECRETS (marked ★) must be filled by the project owner and never committed,
# pasted into chat, or written to logs.

# ===== orchestration =====
GAGENT_TAG=latest
GATEWAY_PORT=40003
# Host directory that holds session artifacts (bind mount). Sandboxes mount
# per-session subdirectories of it, so it must be a real host path.
GAGENT_RUNTIME_DIR=/srv/gagent/runtime
# Owner of the runtime tree; must match APP_UID/APP_GID in the image.
APP_UID=1001
APP_GID=1001
# App image base. Hosts with no Docker Hub route must point this at a registry
# they can reach (e.g. docker.byoryn.cn/library/python:3.12-slim).
APP_BASE_IMAGE=python:3.12-slim
# Gateway image base: any nginx image reachable from the BUILD host. The SPA is
# built outside the image (gagentctl build) so no node image is needed at all.
GATEWAY_BASE_IMAGE=docker.byoryn.cn/ms/webui:ms

# ===== ingress / auth =====
APP_ENV=production
# local = the app's own cookie login; hybrid = also trust gateway identity
# headers (requires PLATFORM_API_BASE_URL); proxy = headers only.
AUTH_MODE=local
AUTH_COOKIE_NAME=ga_session
AUTH_COOKIE_DOMAIN=
AUTH_SESSION_TTL_HOURS=168
AUTH_OPEN_SIGNUP=0
CORS_ORIGINS=https://agent.medicalheart.cn
# ★ Shared secret the reverse proxy must present (X-Gagent-Proxy-Secret) before
# X-Forwarded-* identity headers are trusted. Leave empty to disable the check.
PROXY_AUTH_SHARED_SECRET=
SSO_ALLOWED_REDIRECT_ORIGINS=
SSO_USER_SYNC_API_KEY=

# ===== model gateway (★ secrets) =====
QWEN_API_URL=
QWEN_API_KEY=
QWEN_MODEL=
# Local sub2api Responses endpoint (host-side container) for agentic web search.
QWEN_RESPONSES_LOCAL_URL=http://host.docker.internal:40002/v1/responses
PLATFORM_LLM_API_URL=
PLATFORM_LLM_API_KEY=
PLATFORM_LLM_MODEL=
PLATFORM_LLM_RESPONSES_API_URL=
PLATFORM_API_BASE_URL=
PLATFORM_API_KEY=
EMBEDDING_PROVIDER=qwen
GLM_API_KEY=

# ===== egress =====
# Host-side tunnels stay on the host (systemd): SOCKS 1080 for NCBI/EBI,
# HTTP 7890 for nih.gov. Reach them via host.docker.internal.
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=app,proxy,redis,localhost,127.0.0.1
LITERATURE_PIPELINE_PROXY=socks5://host.docker.internal:1080
WEB_SEARCH_BUILTIN_TIMEOUT=540

# ===== code execution / sandbox (wired in P3) =====
CODE_MODE_ENABLED=1
CODE_EXECUTOR_LOCAL_RUNTIME=docker
CODE_MODE_SANDBOX=0
SANDBOX_PYTHON_IMAGE=gagent-sandbox-python:latest
SANDBOX_QWEN_IMAGE=gagent-sandbox-qwen:latest
SANDBOX_MEM=4g
SANDBOX_CPUS=2
# Interface the tool RPC server binds; the sandbox dials back to this name.
CODE_MODE_RPC_BIND=0.0.0.0
CODE_MODE_RPC_ADVERTISE=app

# ===== storage / retention (GC lands in P4) =====
RUNTIME_RETENTION_DAYS=60
RUNTIME_MAX_GB=300
RUNTIME_ARCHIVE_BEFORE_DELETE=1
EVENT_RETENTION_DAYS=30
USAGE_RETENTION_DAYS=365
JOB_LOG_RETENTION_DAYS=30
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=4
UPLOAD_MAX_BYTES=2147483648
UPLOAD_EXTRACT_MAX_BYTES=8589934592
UPLOAD_EXTRACT_MAX_ENTRIES=20000

# ===== execution knobs (carried over from the current deployment) =====
DEEP_THINK_MAX_ITERATIONS=152
AGENT_ARGUMENT_VALIDATION_ENABLED=1
DELEGATE_TASK_ENABLED=0
PLAN_TASK_EXECUTION_BACKEND=internal
LLM_THINKING_OFF_REASONING_EFFORT=low

# ===== logging / observability =====
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_ENABLED=1

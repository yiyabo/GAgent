# bioagent 部署环境变量模板
# 复制为 .env 后按机器修改；.env 含宿主机路径等敏感信息，不提交仓库。
# compose 与 build.sh 约定全部变量由此文件提供，无代码内默认值。

# ===== 容器编排 =====
# 容器/网络/卷名前缀，须与 dcx 聚合编排一致
COMPOSE_PREFIX=ms

# 对外端口（容器内固定 9000）
BIOAGENT_PORT=9000

# 镜像 tag
BIOAGENT_TAG=latest

# ===== 外部服务 =====
# Redis（实时事件总线）；走 dcx 聚合编排的 web-redis 容器（同 docker 网络）
REDIS_URL=redis://ms-web-redis:6379/0

# ===== 模型服务 =====
# LLM 网关地址与密钥（sub2api），按环境填写
# LLM_BASE_URL=
# LLM_API_KEY=

# ===== 数据与用户体系（必填，漏配会把空路径挂进容器）=====
# 挂载宿主机数据根到容器内 /data（与 dcx 的 HOST_DATA_ROOT 同源）
HOST_DATA_ROOT=/path/to/dcx/data
# 宿主机用户/组定义目录（dcx 的 etc/usersys），供容器内解析平台用户组
HOST_USERSYS_DIR=/path/to/dcx/etc/usersys

# ===== 运行时根（阶段二接入项目文件空间时启用）=====
# 会话运行时根指向项目空间；不设时用 compose 里的默认卷 /app/runtime
# APP_RUNTIME_ROOT=/data/teams

# ===== 平台回源（ms 网关代理鉴权）=====
# hybrid 模式下解析网关注入的平台身份头并回源项目配置；key 向 bioapi 管理员索取
PLATFORM_API_BASE_URL=http://host.docker.internal:3011
PLATFORM_API_KEY=

#!/usr/bin/env bash
# Strip AI co-author / marketing trailers so GitHub contributors stay human-only.
# Installed via: git config core.hooksPath .githooks
set -euo pipefail
msg_file="${1:-}"
[[ -n "$msg_file" && -f "$msg_file" ]] || exit 0

python3 - "$msg_file" <<'PY'
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
text = path.read_text(encoding="utf-8", errors="replace")
lines = text.splitlines()
out = []
for line in lines:
    s = line.strip()
    low = s.lower()
    if not s:
        out.append(line)
        continue
    # Drop Sisyphus / Claude / Anthropic co-author trailers
    if low.startswith("co-authored-by:") or low.startswith("co-authored-by "):
        if any(
            x in low
            for x in (
                "sisyphus",
                "clio-agent",
                "sisyphuslabs",
                "claude",
                "anthropic.com",
                "noreply@anthropic",
                "cursor agent",
                "cursoragent@",
                "roomote@roocode",
            )
        ):
            continue
    if low.startswith("ultraworked with") and "sisyphus" in low:
        continue
    if "oh-my-openagent" in low and low.startswith("ultraworked"):
        continue
    out.append(line)

# Trim trailing blanks; collapse 3+ blank runs
while out and not out[-1].strip():
    out.pop()
clean = []
blank = 0
for line in out:
    if not line.strip():
        blank += 1
        if blank <= 1:
            clean.append(line)
    else:
        blank = 0
        clean.append(line)

new = "\n".join(clean) + ("\n" if clean else "")
if new != text:
    path.write_text(new, encoding="utf-8")
PY

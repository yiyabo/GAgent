{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.yiyabo/phageagent",
  "title": "PhageAgent",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/yiyabo/phageagent-mcp/main/icon.png",
      "mimeType": "image/png",
      "sizes": [
        "256x256"
      ]
    }
  ],
  "description": "PhageAgent MCP: PhageScope phage database and analysis tasks. Sign up at phageagent.deepomics.org.",
  "repository": {
    "url": "https://github.com/yiyabo/phageagent-mcp",
    "source": "github"
  },
  "websiteUrl": "https://github.com/yiyabo/phageagent-mcp",
  "version": "0.2.0",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://phageagent.deepomics.org/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer <PhageAgent MCP token (gpsk_...)>",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}

{
  "name": "phagescope",
  "displayName": "PhageScope",
  "version": "0.1.0",
  "description": "Read-only PhageScope phage database: 2.58M phages, 131M proteins, 12.6M protein families. Access on request: tokens are granted after approval.",
  "author": {
    "name": "PhageScope / GAgent team",
    "url": "https://phageagent.deepomics.org"
  },
  "homepage": "https://github.com/yiyabo/phagescope-mcp",
  "repository": "https://github.com/yiyabo/phagescope-mcp",
  "license": "MIT",
  "keywords": [
    "phage",
    "bacteriophage",
    "bioinformatics",
    "genomics",
    "proteins",
    "phagescope"
  ],
  "documentationUrl": "https://github.com/yiyabo/phagescope-mcp",
  "supportUrl": "https://github.com/yiyabo/phagescope-mcp/issues",
  "privacyPolicyUrl": "https://github.com/yiyabo/phagescope-mcp/blob/main/PRIVACY.md",
  "userConfig": {
    "phagescope_token": {
      "type": "string",
      "title": "PhageScope MCP token",
      "description": "Personal access token (gpsk_...) issued at https://phageagent.deepomics.org via POST /phagescope-mcp/tokens.",
      "sensitive": true
    }
  },
  "mcpServers": {
    "phagescope": {
      "type": "http",
      "url": "https://phageagent.deepomics.org/mcp",
      "headers": {
        "Authorization": "Bearer ${user_config.phagescope_token}"
      }
    }
  }
}
